# Shared environment variables for every workflow that needs them.
# Each workflow job loads this file after `actions/checkout` with
# `sed -n '/^[A-Z]/p' .github/env >> "$GITHUB_ENV"` (`$GITHUB_ENV` rejects
# blank and comment lines). The format is `KEY=VALUE` per line, with no shell
# quoting or interpolation.
#
# `MISE_VERSION` sets every workflow's mise install. Renovate bumps it
# (see the regex manager in renovate.json5).
MISE_VERSION=v2026.11.8
#
# `TOOLR_VERSION` is the toolr binary .github/actions/setup-toolr installs.
# It must match the `aqua:s0undt3ch/ToolR` pin in mise.toml, the action ref's
# version comment in .github/actions/setup-toolr/action.yml and the `toolr-py`
# in tools/uv.lock, or the binary can emit a runner schema the tools venv
# rejects. Renovate's "toolr release" group bumps them together, and
# tests/tools/precommit/test_toolr_pins.py fails when they drift.
TOOLR_VERSION=0.37.0
